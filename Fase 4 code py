#clase de reserva: perimete administar y crear reservas
class Reserva:
    #construccion: inicializacion de los datos de la reserva 
    def __init__(self, codigo, cliente, servicio, duracion):

        if not isinstance(cliente, Cliente):
            raise ReservaError("El cliente no es valido.")

        if not isinstance(servicio, Servicio):
            raise ReservaError("El servicio no es valido.")

        servicio.validar_parametros(duracion)

        self.codigo = codigo
        self.cliente = cliente
        self.servicio = servicio
        self.duracion = duracion
        self.estado = "Pendiente"

        self.costo = servicio.calcular_costo(duracion)

#confirmar:cambia el estado de la reserva a confirmar
    def confirmar(self):

        if self.estado != "Pendiente":
            raise ReservaError(
                "Solo se pueden confirmar reservas pendientes."
            )

        self.estado = "Confirmada"
        logging.info("Reserva %s confirmada.", self.codigo)

# cancelar:permite cancelar una reserva 
    def cancelar(self):

        if self.estado in ("Cancelada", "Procesada"):
            raise ReservaError(
                "No se puede cancelar esta reserva."
            )

        self.estado = "Cancelada"
        logging.info("Reserva %s cancelada.", self.codigo)

#procesar:finaliza la reserva y finalixza su costo
    def procesar(self):

        if self.estado != "Confirmada":
            raise ReservaError(
                "Primero debe confirmar la reserva."
            )

        self.estado = "Procesada"
        logging.info("Reserva %s procesada.", self.codigo)

        return self.costo


# Clase Gestor: administra clientes, servicios y reservas.
class Gestor:
    def __init__(self):
        self.clientes = []
        self.servicios = []
        self.reservas = []
        self.contador = 1

    # Registrar cliente: valida y guarda los datos del cliente.
    def registrar_cliente(self, identificacion, nombre, correo):

        try:
            if any(
                c.identificacion == identificacion
                for c in self.clientes
            ):
                raise DatoInvalidoError(
                    "El cliente ya se encuentra registrado."
                )

            cliente = Cliente(identificacion, nombre, correo)

        except DatoInvalidoError as error:
            logging.error("Error al registrar cliente: %s", error)
            raise

        else:
            self.clientes.append(cliente)
            logging.info("Cliente registrado: %s", identificacion)
            return cliente

    # Registrar servicio: crea y guarda los diferentes servicios.
    def registrar_servicio(self, tipo, precio, descuento, impuesto):

        try:
            codigo = "S" + str(len(self.servicios) + 1)

            if tipo == "Sala":
                servicio = ReservaSala(
                    codigo, "Reserva de sala",
                    precio, descuento, impuesto
                )

            elif tipo == "Equipo":
                servicio = AlquilerEquipo(
                    codigo, "Alquiler de equipo",
                    precio, descuento, impuesto
                )

            elif tipo == "Asesoria":
                servicio = Asesoria(
                    codigo, "Asesoria especializada",
                    precio, descuento, impuesto
                )

            else:
                raise DatoInvalidoError(
                    "Seleccione un tipo de servicio valido."
                )

            self.servicios.append(servicio)

        except DatoInvalidoError as error:
            logging.error("Error al registrar servicio: %s", error)
            raise

        else:
            logging.info("Servicio registrado: %s", servicio.nombre)
            return servicio

    # Buscar servicio: localiza un servicio por su código.
    def buscar_servicio(self, codigo):

        for servicio in self.servicios:
            if servicio.codigo == codigo:
                return servicio

        logging.error("Servicio no disponible: %s", codigo)

        raise ServicioNoDisponibleError(
            "El servicio seleccionado no existe."
        )

    # Crear reserva: registra una nueva reserva.
    def crear_reserva(self, identificacion, codigo, duracion):

        try:
            cliente = next(
                (
                    c for c in self.clientes
                    if c.identificacion == identificacion
                ),
                None
            )

            if cliente is None:
                raise ReservaError("No se encontro el cliente.")

            servicio = self.buscar_servicio(codigo)

            reserva = Reserva(
                self.contador, cliente, servicio, duracion
            )

            self.reservas.append(reserva)
            self.contador += 1

        except (
            ReservaError,
            ServicioNoDisponibleError,
            DatoInvalidoError
        ) as error:
            logging.error("Error al crear reserva: %s", error)
            raise

        else:
            logging.info("Reserva creada correctamente.")
            return reserva

        finally:
            logging.info("Finalizo el intento de crear reserva.")

    # Calcular costos con diferentes opciones
    def calcular_costo(self, servicio, duracion, *opciones):

        try:
            return servicio.calcular_costo(duracion, *opciones)

        except DatoInvalidoError as error:
            raise ErrorSistema(
                "No fue posible realizar el calculo."
            ) from error

