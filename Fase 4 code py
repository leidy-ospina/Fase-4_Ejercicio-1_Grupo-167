    def cancelar_reserva(self, reserva):

        try:
            reserva.cancelar()
            self.actualizar_reservas()

        except ReservaError as error:
            logging.error("Error al cancelar: %s", error)
            messagebox.showerror("Aviso", str(error))

    # Procesar una reserva especifica
    def procesar_reserva(self, reserva):

        try:
            costo = reserva.procesar()

            messagebox.showinfo(
                "Procesamiento",
                f"Reserva procesada.\nTotal: ${costo:,.0f}"
            )

        except ReservaError as error:
            logging.error("Error al procesar: %s", error)
            messagebox.showerror("Aviso", str(error))

        finally:
            self.actualizar_reservas()

    # ---------------- ACTUALIZAR INFORMACION ----------------

    def actualizar_clientes(self):

        valores = [
            f"{c.identificacion} - {c.nombre}"
            for c in self.gestor.clientes
        ]

        self.combo_clientes["values"] = valores

        if valores:
            self.combo_clientes.current(0)
        else:
            self.cliente.set("")

    def actualizar_servicios(self):

        self.lista_servicios.delete(0, tk.END)

        valores = []

        for s in self.gestor.servicios:

            texto = (
                f"{s.codigo} | {s.nombre} | "
                f"${s.precio:,.0f}/h | "
                f"Desc. {s.descuento}% | "
                f"Imp. {s.impuesto}%"
            )

            self.lista_servicios.insert(tk.END, texto)

            valores.append(
                f"{s.codigo} - {s.nombre}"
            )

        self.combo_servicios["values"] = valores

        if valores:
            self.combo_servicios.current(0)
        else:
            self.servicio.set("")

    def actualizar_reservas(self):

        # Eliminar las filas anteriores
        for elemento in self.lista_reservas.winfo_children():
            elemento.destroy()

        # Crear una fila por cada reserva
        for reserva in self.gestor.reservas:

            fila = ttk.Frame(self.lista_reservas)
            fila.pack(fill="x", pady=3)

            ttk.Label(
                fila,
                text=str(reserva.codigo),
                width=8
            ).pack(side="left")

            ttk.Label(
                fila,
                text=reserva.cliente.nombre,
                width=18
            ).pack(side="left")

            ttk.Label(
                fila,
                text=reserva.servicio.nombre,
                width=18
            ).pack(side="left")

            ttk.Label(
                fila,
                text=str(reserva.duracion),
                width=7
            ).pack(side="left")

            ttk.Label(
                fila,
                text=f"${reserva.costo:,.0f}",
                width=14
            ).pack(side="left")

            ttk.Label(
                fila,
                text=reserva.estado,
                width=13
            ).pack(side="left")

            # Botones al lado de cada reserva
            ttk.Button(
                fila,
                text="Confirmar",
                command=lambda r=reserva: self.confirmar_reserva(r)
            ).pack(side="left", padx=2)

            ttk.Button(
                fila,
                text="Cancelar",
                command=lambda r=reserva: self.cancelar_reserva(r)
            ).pack(side="left", padx=2)

            ttk.Button(
                fila,
                text="Procesar",
                command=lambda r=reserva: self.procesar_reserva(r)
            ).pack(side="left", padx=2)

    def actualizar_todo(self):
        self.actualizar_clientes()
        self.actualizar_servicios()
        self.actualizar_reservas()


