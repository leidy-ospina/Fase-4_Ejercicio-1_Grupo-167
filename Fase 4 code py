                f"Costo total: ${reserva.costo:,.0f}"
            )

        except ValueError as error:
            logging.error("Duracion incorrecta: %s", error)
            messagebox.showerror(
                "Error", "Ingrese una cantidad de horas valida."
            )

        except ErrorSistema as error:
